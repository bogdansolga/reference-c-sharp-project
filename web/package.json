{
  "name": "reference-c-sharp-web",
  "description": "Reused Next.js frontend for the C# reference project — talks to the ASP.NET Core API",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome check",
