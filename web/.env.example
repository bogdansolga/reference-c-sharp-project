# Anthropic API key for the chat widget (POST /api/chat). Required for chat.
ANTHROPIC_API_KEY=

# Optional: Claude model for chat (default: claude-haiku-4-5)
# CHAT_MODEL=claude-haiku-4-5

# Optional: C# API base URL. Used both by next.config rewrites and by server
# components fetching data directly (default http://localhost:5099).
# API_URL=http://localhost:5099
