# Anthropic API key for the chat widget (POST /api/chat). Required for chat.
ANTHROPIC_API_KEY=

# Optional: Claude model for chat (default: claude-haiku-4-5)
# CHAT_MODEL=claude-haiku-4-5

# Optional: Next origin used by server components for absolute fetch (default http://localhost:3000)
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: C# API base URL proxied by next.config rewrites (default http://localhost:5099)
# API_URL=http://localhost:5099
